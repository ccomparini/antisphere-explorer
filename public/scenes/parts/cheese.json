{
  "_comment": "cheese texture (and, later, bump) map test object",
  "materials": {
    "blue-cheese": {
      "texture": "@blue_cheese.png"
    }
  },
  "objects": {
    "cheese-wheel": {
      "plane": {
        "normal": [ 0, 0, 1 ],
        "offset": 0.4
      },
      "inside": {
        "plane": {
          "normal": [ 0, 0, -1 ],
          "offset": 0
        },
        "inside": {
          "cylinder": {
            "radius": 1
          }
        }
      }
    },
    "wedge": {
      "plane" : {
        "normal": [ -1, 0, 0 ]
      },
        "inside": {
          "plane" : {
            "normal": [ 0.866, 0.5, 0 ]
          }
        }
    },
    "cheese-wedge": {
      "intersection": [
        { "use": "@#/objects/cheese-wheel" },
        { "use": "@#/objects/wedge" }
      ]
    }
  },
  "root": {
    "cheese-wedge": {
      "intersection": [
        { "use": "cheese-wheel" },
        { "use": "wedge" }
      ]
    }
  }
}
