{
  "_comment": "Tori from parts/torus.stl, a mesh converted to planes as it loads. An STL import offers one object and one material, both named for the file: torus:torus. Its faces each name that material, so a material given where it is used changes nothing; writing torus:torus among this scene's materials re-skins every instance.",

  "import": ["parts/torus.stl"],

  "materials": {
    "floor": { "albedo": [0.30, 0.31, 0.34], "albedo2": [0.18, 0.19, 0.21],
               "pattern": "checker", "scale": 2 },
    "sky": { "kind": "unlit", "albedo": [0.07, 0.09, 0.14] }
  },

  "lights": [
    { "pos": [4, -6, 7], "color": [260, 250, 235] },
    { "pos": [-5, -2, 3], "color": [70, 76, 92] }
  ],

  "camera": { "target": [0, 0, 0.4], "yaw": 0.9, "pitch": 0.45, "distance": 6 },

  "objects": {
    "flat": { "use": "torus:torus", "translate": [-1.3, 0, 0] },
    "standing": { "use": "torus:torus",
                  "rotate": { "axis": [1, 0, 0], "degrees": 90 },
                  "translate": [1.3, 0.3, 1.0] },
    "small": { "use": "torus:torus", "scale": 0.5, "translate": [0.3, 1.6, 0] }
  },

  "root": {
    "sphere": { "center": [0, 0, 0], "radius": 400 },
    "inside": {
      "plane": { "normal": [0, 0, 1], "offset": 0 },
      "material": "floor",
      "outside": {
        "union": [
          "flat", "standing", "small",
          { "sphere": { "center": [0, 0, 0], "radius": 399 },
            "complement": true, "material": "sky" }
        ]
      }
    }
  }
}
