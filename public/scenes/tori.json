{
  "_comment": "Tori from parts/torus.stl, a mesh converted to planes as it loads, by reference: every use of it shares one set of nodes. An STL is only geometry, so it is made of a material named for the file, torus, which a scene defines - or, as each placement here does, a use names another.",

  "materials": [
    "@lib/materials.json",
    {
      "floor": { "albedo": [0.30, 0.31, 0.34], "albedo2": [0.18, 0.19, 0.21],
                 "pattern": "checker", "scale": 2 },
      "teal": { "albedo": [0.15, 0.55, 0.55], "kind": "glossy", "shininess": 60, "specular": 0.5 }
    }
  ],

  "lights": [
    { "pos": [4, -6, 7], "color": [260, 250, 235] },
    { "pos": [-5, -2, 3], "color": [70, 76, 92] }
  ],

  "camera": { "position": [4.232067, 3.358361, 3.009793], "direction": [-0.705344, -0.559727, -0.434966], "distance": 6 },

  "objects": {
    "flat": { "use": "@parts/torus.stl", "material": "gold", "translate": [-1.3, 0, 0] },
    "standing": { "use": "@parts/torus.stl",
                  "material": "gold",
                  "rotate": { "axis": [1, 0, 0], "degrees": 90 },
                  "translate": [1.3, 0.3, 1.0] },
    "small": { "use": "@parts/torus.stl",
               "material": "teal",
               "scale": 0.5,
               "translate": [0.3, 1.6, 0] }
  },

  "root": {
    "sphere": { "center": [0, 0, 0], "radius": 400 },
    "inside": {
      "plane": { "normal": [0, 0, 1], "offset": 0 },
      "material": "floor",
      "outside": {
        "union": [
          "flat", "standing", "small",
          { "sphere": { "center": [0, 0, 0], "radius": 399 },
            "complement": true, "material": "sky" }
        ]
      }
    }
  }
}
