// Two-particle physics, for physlab: each body is two particles joined by
// a constraint (XPBD; see "bodies" below), so it knows its axis and
// carries its roll. Other physics models are to sit beside this one, as
// physics-*.wgsls. Contacts between solids come from collision.wgsls.

// collision.wgsls brings overlap.wgsls, node.wgsls, and nodes.
#import "collision.wgsls"

// -- bodies: points joined by constraints ------------------------------------------
//
// Position-based (XPBD): each substep predicts where every particle goes
// under gravity and any thrust, then corrects the predictions to satisfy
// the constraints, and takes velocity from how far each actually moved.
//
// Coordinates are the simulation's own: the host shifts everything by an
// origin near the action (a floating origin), so that f32 positions keep
// their resolution. 500 m out, f32 resolves ~6e-5 m, which as a velocity
// over a 1/240 s substep is ~0.015 m/s of noise; 20 m out it is 25 times
// less. So gravity's centre is a parameter, not the origin.

struct Particle {
  pos      : vec3<f32>,
  inv_mass : f32,       // 0: pinned, never moved
  vel      : vec3<f32>,
  body     : u32,       // the body it belongs to
  start    : vec3<f32>, // where it was at the start of this substep
  pre_vel  : vec3<f32>, // its velocity as predicted, before any constraint
};

// A body: two particles, what joins them, and the solid it is.
//
// Its geometry is a solid in the body's own coordinates, and it must be
// coaxial with +Y: every node a surface of revolution about the Y axis
// (the host checks). Then where it is placed depends only on the axis and
// an origin, never on a roll about the axis, which two particles can't
// say and which such a solid wouldn't show anyway. The particles sit on
// that axis at local y = a0 and a1.
struct Body {
  p0         : u32,
  p1         : u32,
  rest       : f32,        // the particles' distance apart, unstressed
  compliance : f32,        // XPBD compliance of that distance, m/N; 0 is rigid
  thrust     : vec3<f32>,  // extra acceleration on both particles (a motor), m/s^2
  solid      : u32,        // its geometry, in solids
  a0         : f32,        // where p0 sits on the local Y axis
  a1         : f32,        // and p1
  radius     : f32,        // how far its solid reaches from its local origin, at most
  friction   : f32,        // Coulomb coefficient against what it touches
};

struct SimParams {
  gravity_centre : vec3<f32>,  // in simulation coordinates
  gm             : f32,        // G times the planet's mass: gravity is gm / r^2
  h              : f32,        // substep, seconds
  particle_count : u32,
  body_count     : u32,
  first_static   : u32,        // solids from here on collide but never move
  static_count   : u32,
  pair_count     : u32,        // path pairs for detect() to try (see pathPairs)
  gravity_uniform : vec3<f32>, // gravity the same everywhere, where gm is 0
};

var<storage, read_write> particles : array<Particle>;
var<storage, read> bodies : array<Body>;
var<uniform> sim : SimParams;

fn gravityAt(p : vec3<f32>) -> vec3<f32> {
  if (sim.gm == 0.0) { return sim.gravity_uniform; }
  let r = sim.gravity_centre - p;
  let d2 = max(dot(r, r), 1e-6);
  return sim.gm * r / (d2 * sqrt(d2));
}

// 1. Predict: velocity from gravity and thrust, position from velocity.
@compute @workgroup_size(64)
fn predict(@builtin(global_invocation_id) gid : vec3<u32>) {
  let i = gid.x;
  if (i >= sim.particle_count) { return; }
  var q = particles[i];
  q.start = q.pos;
  if (q.inv_mass > 0.0) {
    q.vel = q.vel + (gravityAt(q.pos) + bodies[q.body].thrust) * sim.h;
    q.pos = q.pos + q.vel * sim.h;
  }
  q.pre_vel = q.vel;
  particles[i] = q;
}

// 2. Solve: each body's distance constraint. A particle belongs to one
// body, so bodies can be solved in parallel without contention.
@compute @workgroup_size(64)
fn solveDistance(@builtin(global_invocation_id) gid : vec3<u32>) {
  let b = gid.x;
  if (b >= sim.body_count) { return; }
  let body = bodies[b];
  var a = particles[body.p0];
  var c = particles[body.p1];
  let w = a.inv_mass + c.inv_mass;
  let d = c.pos - a.pos;
  let len = length(d);
  let alpha = body.compliance / (sim.h * sim.h);
  if (w + alpha <= 0.0 || len < 1e-9) { return; }
  // XPBD with a fresh multiplier each substep: dlambda = -C / (w + alpha),
  // moving each end along the line by its share of inverse mass.
  let dl = -(len - body.rest) / (w + alpha);
  let n = d / len;
  a.pos = a.pos - a.inv_mass * dl * n;
  c.pos = c.pos + c.inv_mass * dl * n;
  particles[body.p0] = a;
  particles[body.p1] = c;
}

// 3. Velocity from where each particle actually got to. That is
// (pos - start) / h, but taken as the predicted velocity plus only what the
// constraints changed: v + (pos - predicted) / h. The same in exact
// arithmetic, and far better in f32, where pos - start is a small
// difference of large numbers - 600 m out, the textbook form puts a free
// fall 12 cm off in a second, and an orbit 1.8% off in ten. The predicted
// position is recomputed exactly as predict() made it, so a particle no
// constraint moved keeps its velocity bit for bit.
@compute @workgroup_size(64)
fn updateVelocity(@builtin(global_invocation_id) gid : vec3<u32>) {
  let i = gid.x;
  if (i >= sim.particle_count) { return; }
  var q = particles[i];
  if (q.inv_mass > 0.0) {
    let predicted = q.start + q.vel * sim.h;
    q.vel = q.vel + (q.pos - predicted) / sim.h;
  }
  particles[i] = q;
}

// -- collisions -------------------------------------------------------------------
//
// Each substep, after the prediction: place every body's solid where its
// particles now are (pose), find where bodies meet the static solids
// (detect), then a few rounds of pushing them out (solveContacts, then
// applyCorrections) alternating with the bodies' own constraints.
//
// A push is a rigid-body one. A body's two particles give its centre of
// mass and its inertia about axes square to it; a push at x along n moves
// the centre and turns the body by (r x n), r from the centre to x, less
// its part along the axis - the roll two particles can't hold, and a solid
// of revolution wouldn't show. So a push at the rim of a rocket's base
// tips it, and pushes all round the rim cancel and let it stand; sharing
// the push between the particles by where x falls along the axis alone
// would stand it like a needle on its point.

// Where each solid's paths and nodes are.
struct Solid {
  first_path : u32,
  path_count : u32,
  first_node : u32,
  node_count : u32,
};

// A contact found this substep between a body and something else - a
// static solid, or another body - with how each stood when it was found,
// so its depth can be followed as they are pushed apart.
struct BodyContact {
  point       : vec3<f32>,  // where found
  depth       : f32,        // how deep then
  normal      : vec3<f32>,  // unit, the way to push `body` out of `other`
  body        : u32,
  lever       : vec3<f32>,  // from the body's centre of mass to the point, then
  other       : u32,        // another body (< body_count), or a static solid
  axis        : vec3<f32>,  // the body's axis, then
  other_lever : vec3<f32>,  // the same for the other, when it is a body
  other_axis  : vec3<f32>,
};

var<storage, read> solids : array<Solid>;
var<storage, read> localNodes : array<Node>;
var<storage, read_write> posedNodes : array<Node>;
var<storage, read_write> bodyContacts : array<BodyContact>;
var<storage, read_write> contactCount : atomic<u32>;
var<storage, read_write> corrections : array<atomic<i32>>;

// Corrections are summed as integers, in units of 2^-20 m: WGSL atomics
// are integers only, and that is a micron's resolution with a kilometre
// of range.
const FIXED : f32 = 1048576.0;

fn axisOf(x0 : vec3<f32>, x1 : vec3<f32>) -> vec3<f32> {
  let d = x1 - x0;
  let len = length(d);
  if (len < 1e-9) { return vec3<f32>(0.0, 1.0, 0.0); }
  return d / len;
}

// A body's centre of mass, axis, mass and inertia about axes square to
// the axis, from its particles (now, or at the substep's start).
struct Frame {
  centre  : vec3<f32>,
  mass    : f32,
  axis    : vec3<f32>,
  inertia : f32,
};

fn frameOf(x0 : vec3<f32>, x1 : vec3<f32>, m0 : f32, m1 : f32) -> Frame {
  let m = m0 + m1;
  let c = (m0 * x0 + m1 * x1) / m;
  let i = m0 * dot(x0 - c, x0 - c) + m1 * dot(x1 - c, x1 - c);
  return Frame(c, m, axisOf(x0, x1), i);
}

// Each body's orientation, as a quaternion (x, y, z, w) taking its own
// coordinates to the simulation's. Two particles fix only its axis, so
// the rest - its roll about that axis - is carried along: each substep the
// orientation turns the shortest way from where it put the axis to where
// the particles now say it is. Nothing turns a body about its own axis
// (push() gives no roll), so roll is kept, not simulated. The host sets
// each body's to start with and reads them back to draw the bodies, so
// what is drawn is what collides.
var<storage, read_write> turns : array<vec4<f32>>;

// v turned by unit quaternion q.
fn quatRotate(q : vec4<f32>, v : vec3<f32>) -> vec3<f32> {
  let t = 2.0 * cross(q.xyz, v);
  return v + q.w * t + cross(q.xyz, t);
}

// a then b: the turn that is b after a.
fn quatAfter(b : vec4<f32>, a : vec4<f32>) -> vec4<f32> {
  return vec4<f32>(b.w * a.xyz + a.w * b.xyz + cross(b.xyz, a.xyz), b.w * a.w - dot(b.xyz, a.xyz));
}

// The shortest turn taking unit vector a to unit vector b; turned right
// round, half a turn about any line square to a (as quat.js's fromTo).
fn quatFromTo(a : vec3<f32>, b : vec3<f32>) -> vec4<f32> {
  let c = dot(a, b);
  if (c < -0.999999) {
    var other = vec3<f32>(1.0, 0.0, 0.0);
    if (abs(a.x) >= 0.9) { other = vec3<f32>(0.0, 1.0, 0.0); }
    return vec4<f32>(normalize(cross(a, other)), 0.0);
  }
  return normalize(vec4<f32>(cross(a, b), 1.0 + c));
}

// A node given in the body's coordinates, placed with its local origin at
// o and turned by q. With K = k I + dk a a^T: the axis and the linear term
// turn, the curvatures stay, and translating by o takes linear to
// linear - 2 K o and const to const + o.K.o - linear.o.
fn placeTurned(nd : Node, o : vec3<f32>, q : vec4<f32>) -> Node {
  var w = nd;
  let a = quatRotate(q, nd.axis);
  let lin = quatRotate(q, nd.linear);
  let ko = nd.curvature_perp * o + nd.curvature_delta * dot(a, o) * a;
  w.axis = a;
  w.linear = lin - 2.0 * ko;
  w.const_term = nd.const_term + dot(o, ko) - dot(lin, o);
  return w;
}

// Turn each body's orientation onto its particles' axis, and place its
// solid there.
@compute @workgroup_size(64)
fn pose(@builtin(global_invocation_id) gid : vec3<u32>) {
  let b = gid.x;
  if (b >= sim.body_count) { return; }
  let body = bodies[b];
  let x0 = particles[body.p0].pos;
  let u = axisOf(x0, particles[body.p1].pos);
  let o = x0 - body.a0 * u;
  let was = turns[b];
  let q = normalize(quatAfter(quatFromTo(quatRotate(was, vec3<f32>(0.0, 1.0, 0.0)), u), was));
  turns[b] = q;
  let solid = solids[body.solid];
  for (var n = 0u; n < solid.node_count; n = n + 1u) {
    let at = solid.first_node + n;
    posedNodes[at] = placeTurned(localNodes[at], o, q);
  }
}

@compute @workgroup_size(1)
fn clearContacts() {
  atomicStore(&contactCount, 0u);
}

// A body's particles, frame and whether it can be moved at all.
struct Side {
  body    : Body,
  f       : Frame,
  x0      : vec3<f32>,
  x1      : vec3<f32>,
  movable : bool,
};

fn sideOf(b : u32) -> Side {
  let body = bodies[b];
  let q0 = particles[body.p0];
  let q1 = particles[body.p1];
  let movable = q0.inv_mass > 0.0 && q1.inv_mass > 0.0;       // a pinned body isn't
  let f = frameOf(q0.pos, q1.pos, 1.0 / max(q0.inv_mass, 1e-20), 1.0 / max(q1.inv_mass, 1e-20));
  return Side(body, f, q0.pos, q1.pos, movable);
}

// The same body's frame at the start of this substep.
fn startFrameOf(s : Side) -> Frame {
  let q0 = particles[s.body.p0];
  let q1 = particles[s.body.p1];
  return frameOf(q0.start, q1.start, 1.0 / max(q0.inv_mass, 1e-20), 1.0 / max(q1.inv_mass, 1e-20));
}

fn recordContact(c : Contact, b : u32, other : u32) {
  let at = atomicAdd(&contactCount, 1u);
  if (at >= arrayLength(&bodyContacts)) { return; }
  let f = sideOf(b).f;
  var otherLever = vec3<f32>(0.0);
  var otherAxis = vec3<f32>(0.0, 1.0, 0.0);
  if (other < sim.body_count) {
    let g = sideOf(other).f;
    otherLever = c.point - g.centre;
    otherAxis = g.axis;
  }
  bodyContacts[at] = BodyContact(c.point, c.depth, c.normal, b, c.point - f.centre, other, f.axis,
                                 otherLever, otherAxis);
}

// Rounds of settling a manifold seed into the overlap: more than for the
// first point, since a seed starts well outside.
const MANIFOLD_SWEEPS : i32 = 24;

// Record a contact between paths pa (of body b) and pb (of `other`), and,
// where both sides are flat at the body's scale - a base on the ground, a
// rod's side along its length - more points across the overlap: seeds
// spread round `centre` (a body's centre of mass) as it falls on the
// contact plane, each settled into the overlap, so they land at its edges
// on every side. (Spread round the first point, which is often at the
// rim, half of them fell off the face, and the rest held only the half of
// the base that point was on - the other side, every other substep.) One point can't hold a flat face
// that bears an off-centre load: a ball resting 0.3 m out on a puck
// tipped it on its single contact, then rolled down the slope it made. (A
// ball needs none: its one support point is exact.)
fn recordPair(pa : Path, pb : Path, c : Contact, b : u32, other : u32, reach : f32, centre : vec3<f32>) {
  recordContact(c, b, other);
  if (bulgesAt(tightest(pa, c.point), reach) || bulgesAt(tightest(pb, c.point), reach)) { return; }
  let n = c.normal;
  var t1 = cross(n, vec3<f32>(1.0, 0.0, 0.0));
  if (dot(t1, t1) < 1e-6) { t1 = cross(n, vec3<f32>(0.0, 1.0, 0.0)); }
  t1 = normalize(t1);
  let t2 = cross(n, t1);
  let under = centre - dot(centre - c.point, n) * n;
  var kept = array<vec3<f32>, 5>(c.point, vec3<f32>(0.0), vec3<f32>(0.0), vec3<f32>(0.0), vec3<f32>(0.0));
  var count = 1u;
  for (var k = 0u; k < 4u; k = k + 1u) {
    var dir = t1;
    if (k == 1u) { dir = -t1; }
    if (k == 2u) { dir = t2; }
    if (k == 3u) { dir = -t2; }
    let m = contactAt(pa, pb, settleFor(pa, pb, under + 0.9 * reach * dir, MANIFOLD_SWEEPS));
    if (m.found == 0u) { continue; }
    var fresh = true;
    for (var j = 0u; j < count; j = j + 1u) {
      if (distance(kept[j], m.point) < 0.1 * reach) { fresh = false; }
    }
    if (fresh) {
      kept[count] = m.point;
      count = count + 1u;
      recordContact(m, b, other);
    }
  }
}

// Where a body's solid is centred: its local origin, placed.
fn originOf(b : u32) -> vec3<f32> {
  let body = bodies[b];
  let x0 = particles[body.p0].pos;
  return x0 - body.a0 * axisOf(x0, particles[body.p1].pos);
}

// A path of a body and a path of something it may touch - a static solid,
// or another body - to test for contact. The host lists them (all of them
// to start with; then whichever a broad phase says may touch), and
// detect() takes one each. (One
// thread per pair of bodies, trying each pair of their paths in turn, took
// 3 ms a substep for one capsule on the ground, and 14 ms more for five
// capsules touching: the pairs' paths ran one after another.)
struct PathPair {
  body   : u32,
  other  : u32,       // another body (< body_count), or a static solid
  path_a : u32,       // into paths: one of body's
  path_b : u32,       // and one of other's
};

var<storage, read> pathPairs : array<PathPair>;

// A contact for each pair of paths that meet (recordPair). Two bodies are
// tried only if their bounding spheres (each `radius` about its placed
// origin) meet. Under a tilted base the first point is the low rim, which
// is where the righting push belongs.
@compute @workgroup_size(64)
fn detect(@builtin(global_invocation_id) gid : vec3<u32>) {
  let i = gid.x;
  if (i >= sim.pair_count) { return; }
  let job = pathPairs[i];
  let a = job.body;
  let b = job.other;
  var reach = bodies[a].radius;
  var centre = sideOf(a).f.centre;
  if (b < sim.body_count) {
    if (distance(originOf(a), originOf(b)) > bodies[a].radius + bodies[b].radius) { return; }
    // A manifold spreads round the smaller one, whose face is the one to hold.
    if (bodies[b].radius < reach) { reach = bodies[b].radius; centre = sideOf(b).f.centre; }
  }
  let pa = paths[job.path_a];
  let pb = paths[job.path_b];
  let c = pathContact(pa, pb);
  if (c.found != 0u) { recordPair(pa, pb, c, a, b, reach, centre); }
}

// How much a push along dir at r (from the centre) moves that point, per
// unit of push: 1/mass, plus the turning its lever arm gives, with no roll.
fn resistanceOf(f : Frame, r : vec3<f32>, dir : vec3<f32>) -> f32 {
  let torque = cross(r, dir);
  let square = torque - dot(torque, f.axis) * f.axis;
  var w = 1.0 / f.mass;
  if (f.inertia > 1e-12) { w = w + dot(square, square) / f.inertia; }
  return w;
}

// Push a body at r (from its centre) along dir by lambda: move its centre
// by dir lambda / mass and turn it by (r x dir, less roll) lambda / inertia,
// adding what that does to each particle to the corrections.
fn push(s : Side, r : vec3<f32>, dir : vec3<f32>, lambda : f32) {
  let torque = cross(r, dir);
  let square = torque - dot(torque, s.f.axis) * s.f.axis;
  let shift = dir * lambda / s.f.mass;
  var turn = vec3<f32>(0.0);
  if (s.f.inertia > 1e-12) { turn = square * lambda / s.f.inertia; }
  let d0 = shift + cross(turn, s.x0 - s.f.centre);
  let d1 = shift + cross(turn, s.x1 - s.f.centre);
  let a = s.body.p0 * 4u;
  let c = s.body.p1 * 4u;
  atomicAdd(&corrections[a], i32(round(d0.x * FIXED)));
  atomicAdd(&corrections[a + 1u], i32(round(d0.y * FIXED)));
  atomicAdd(&corrections[a + 2u], i32(round(d0.z * FIXED)));
  atomicAdd(&corrections[c], i32(round(d1.x * FIXED)));
  atomicAdd(&corrections[c + 1u], i32(round(d1.y * FIXED)));
  atomicAdd(&corrections[c + 2u], i32(round(d1.z * FIXED)));
}

fn counted(s : Side) {
  atomicAdd(&corrections[s.body.p0 * 4u + 3u], 1);
  atomicAdd(&corrections[s.body.p1 * 4u + 3u], 1);
}

// Where a point fixed in the body - `lever` from the centre, with the body
// along `axis`, when found - is when the body's frame is f. A two-particle
// body can only have turned the shortest way from `axis` to f.axis (it has
// no roll), so that turn, applied to the whole lever, is exact. (Projecting
// the lever's sideways part onto the new cross-section instead is right
// only for some turns, and a rolling ball is one it gets wrong: friction
// then saw slides that weren't there, and drove the ball along.)
fn carried(f : Frame, lever : vec3<f32>, axis : vec3<f32>) -> vec3<f32> {
  let c = dot(axis, f.axis);
  let w = cross(axis, f.axis);
  // Rodrigues for the turn taking `axis` to f.axis:
  // v c + w x v + w (w . v) / (1 + c). Turned right round, it is undefined.
  var turned = lever;
  if (c > -0.999999) { turned = lever * c + cross(w, lever) + w * (dot(w, lever) / (1.0 + c)); }
  return f.centre + turned;
}

// Each contact still overlapping pushes the two apart by what's left of
// its depth, shared by how easily each gives at the contact (a static
// solid, or a pinned body, not at all); then friction takes back up to
// friction x depth of the two points' sliding past each other over this
// substep.
@compute @workgroup_size(64)
fn solveContacts(@builtin(global_invocation_id) gid : vec3<u32>) {
  let i = gid.x;
  if (i >= min(atomicLoad(&contactCount), arrayLength(&bodyContacts))) { return; }
  let c = bodyContacts[i];
  let a = sideOf(c.body);
  let isBody = c.other < sim.body_count;
  var b = a;                                 // stands in when the other is static
  var bMoves = false;
  if (isBody) { b = sideOf(c.other); bMoves = b.movable; }
  if (!a.movable && !bMoves) { return; }

  // Where each side's contact point is now; a static side's is where it was.
  let xa = carried(a.f, c.lever, c.axis);
  var xb = c.point;
  if (isBody) { xb = carried(b.f, c.other_lever, c.other_axis); }
  let depth = c.depth - dot((xa - c.point) - (xb - c.point), c.normal);
  if (depth <= 0.0) { return; }

  let ra = xa - a.f.centre;
  let rb = xb - b.f.centre;
  var w = 0.0;
  if (a.movable) { w = w + resistanceOf(a.f, ra, c.normal); }
  if (bMoves) { w = w + resistanceOf(b.f, rb, c.normal); }
  let lambda = depth / w;
  if (a.movable) { push(a, ra, c.normal, lambda); }
  if (bMoves) { push(b, rb, -c.normal, lambda); }

  // Friction on the relative slide since the substep began.
  var slide = xa - carried(startFrameOf(a), c.lever, c.axis);
  var mu = a.body.friction;
  if (isBody) {
    slide = slide - (xb - carried(startFrameOf(b), c.other_lever, c.other_axis));
    mu = 0.5 * (mu + b.body.friction);
  }
  let across = slide - dot(slide, c.normal) * c.normal;
  let len = length(across);
  if (len > 1e-9) {
    let t = -across / len;
    var wt = 0.0;
    if (a.movable) { wt = wt + resistanceOf(a.f, ra, t); }
    if (bMoves) { wt = wt + resistanceOf(b.f, rb, t); }
    let lt = min(len, mu * depth) / wt;
    if (a.movable) { push(a, ra, t, lt); }
    if (bMoves) { push(b, rb, -t, lt); }
  }
  if (a.movable) { counted(a); }
  if (bMoves) { counted(b); }
}

// A particle's summed corrections, averaged over the contacts that made
// them (Jacobi), and cleared for the next round.
fn takeCorrection(i : u32) -> vec3<f32> {
  let n = atomicLoad(&corrections[i * 4u + 3u]);
  var d = vec3<f32>(0.0);
  if (n > 0) {
    d = vec3<f32>(f32(atomicLoad(&corrections[i * 4u])),
                  f32(atomicLoad(&corrections[i * 4u + 1u])),
                  f32(atomicLoad(&corrections[i * 4u + 2u]))) / (FIXED * f32(n));
  }
  for (var k = 0u; k < 4u; k = k + 1u) { atomicStore(&corrections[i * 4u + k], 0); }
  return d;
}

@compute @workgroup_size(64)
fn applyCorrections(@builtin(global_invocation_id) gid : vec3<u32>) {
  let i = gid.x;
  if (i >= sim.particle_count) { return; }
  particles[i].pos = particles[i].pos + takeCorrection(i);
}

// -- contact velocities -------------------------------------------------------------
//
// Velocity comes from how far a substep moved things (updateVelocity), so
// every push out of an overlap becomes speed away from the contact too. A
// body landing needs that, but a body at rest sinks by g h^2 each substep,
// is pushed out by about as much, rarely exactly and never twice the same
// (Jacobi averaging, contact points that move, fixed-point corrections),
// and what's left over is a small bounce, every substep: resting things
// shimmer. So after the velocity update, each contact is given back the
// normal velocity it had before the solve, bounced by RESTITUTION - but only
// ever by taking speed away from it, so nothing is held down, and a body
// already leaving (thrust, a spring) keeps what it had. This is the
// velocity pass of Mueller et al., "Detailed Rigid Body Simulation with
// Extended Position Based Dynamics" (2020), one-sided.

// How much of the approach speed a contact bounces back with. None, for
// now; it belongs with the materials, when they grow physical properties.
const RESTITUTION : f32 = 0.0;

// The velocity of the body point at r from the body's centre, from its
// particles' velocities now or as predicted: the centre's, plus the turn
// the particles' difference says (axis x (v1 - v0) / length), which has
// no roll, as push() gives none.
fn velocityAt(s : Side, r : vec3<f32>, predicted : bool) -> vec3<f32> {
  let q0 = particles[s.body.p0];
  let q1 = particles[s.body.p1];
  var v0 = q0.vel;
  var v1 = q1.vel;
  if (predicted) { v0 = q0.pre_vel; v1 = q1.pre_vel; }
  let m0 = 1.0 / max(q0.inv_mass, 1e-20);
  let m1 = 1.0 / max(q1.inv_mass, 1e-20);
  var v = (m0 * v0 + m1 * v1) / (m0 + m1);
  let len = length(s.x1 - s.x0);
  if (len > 1e-9) { v = v + cross(cross(s.f.axis, v1 - v0) / len, r); }
  return v;
}

// Corrections here are velocities, summed in the same fixed point: a
// micron a second's resolution, and two kilometres a second of range.
@compute @workgroup_size(64)
fn solveContactVelocities(@builtin(global_invocation_id) gid : vec3<u32>) {
  let i = gid.x;
  if (i >= min(atomicLoad(&contactCount), arrayLength(&bodyContacts))) { return; }
  let c = bodyContacts[i];
  let a = sideOf(c.body);
  let isBody = c.other < sim.body_count;
  var b = a;
  var bMoves = false;
  if (isBody) { b = sideOf(c.other); bMoves = b.movable; }
  if (!a.movable && !bMoves) { return; }

  let xa = carried(a.f, c.lever, c.axis);
  var xb = c.point;
  if (isBody) { xb = carried(b.f, c.other_lever, c.other_axis); }
  let ra = xa - a.f.centre;
  let rb = xb - b.f.centre;

  // Normal speeds, positive apart: now, and as predicted.
  var rel = vec3<f32>(0.0);
  var before = vec3<f32>(0.0);
  if (a.movable) { rel = velocityAt(a, ra, false); before = velocityAt(a, ra, true); }
  if (bMoves) { rel = rel - velocityAt(b, rb, false); before = before - velocityAt(b, rb, true); }
  let vn = dot(rel, c.normal);
  let vn0 = dot(before, c.normal);
  let want = max(vn0, -RESTITUTION * vn0);    // approaching: the bounce; leaving: as it was
  let dv = min(want - vn, 0.0);                 // only ever slowed
  if (dv >= 0.0) { return; }

  var w = 0.0;
  if (a.movable) { w = w + resistanceOf(a.f, ra, c.normal); }
  if (bMoves) { w = w + resistanceOf(b.f, rb, c.normal); }
  let lambda = dv / w;
  if (a.movable) { push(a, ra, c.normal, lambda); counted(a); }
  if (bMoves) { push(b, rb, -c.normal, lambda); counted(b); }
}

@compute @workgroup_size(64)
fn applyVelocityCorrections(@builtin(global_invocation_id) gid : vec3<u32>) {
  let i = gid.x;
  if (i >= sim.particle_count) { return; }
  particles[i].vel = particles[i].vel + takeCorrection(i);
}
