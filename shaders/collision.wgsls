// Collision: where two solids meet - a point, how deep, and which way to
// push them apart - from the overlap certificate (overlap.wgsls). Any
// physics model's contacts come from here; physics-*.wgsls import it.
//
// A solid is a list of paths, each a conjunction of regions (a node and a
// side: sign * H < 0 inside) - interiorPaths() in public/overlap.js makes
// them from a compiled tree. Two solids touch where some path of one and
// some path of the other share a point.
//
// Unlike overlap.wgsls, which is exact and checked against overlap.js, this
// is tuned (CONTACT_SLOP, the sweep counts) and has no CPU twin.

// overlap.wgsls brings node.wgsls, and nodes.
#import "overlap.wgsls"

struct Region {
  node : u32,
  sign : f32,         // +1 the node's inside, -1 its outside
};

struct Path {
  first : u32,        // regions[first .. first + count] together
  count : u32,
};

// Where two solids meet, if they do.
struct Contact {
  point  : vec3<f32>, // a point inside (or on) both
  depth  : f32,       // how far they overlap there; about 0 when touching
  normal : vec3<f32>, // unit, out of B towards A: the way to push A off B
  found  : u32,       // 1 if there is a contact, and the rest means something
};

var<storage, read> regions : array<Region>;
var<storage, read> paths : array<Path>;

// How far outside a region p is (negative inside), measured along the
// gradient: on the line p + s n, n = grad H / |grad H|, H is exactly the
// quadratic H + s |grad H| + s^2 n.K.n, and its root nearest s = 0 is where
// that line crosses the surface. Exact for spheres and planes, and much
// better than H / |grad H| deep inside anything curved (for a sphere that
// is (d^2 - r^2) / 2d, which overstates a depth by the square of it). With
// no root on the line, the first-order H / |grad H| stands in.
fn regionDistance(r : Region, p : vec3<f32>) -> f32 {
  let nd = nodes[r.node];
  let g = r.sign * gradAt(nd, p);
  let slope = length(g);
  let h = r.sign * fAt(nd, p);
  let crit = atCritical(r, h, slope);
  if (crit.found) { return crit.distance; }
  let n = g / slope;
  let along = dot(nd.axis, n);
  let curve = r.sign * (nd.curvature_perp + nd.curvature_delta * along * along);
  let disc = slope * slope - 4.0 * curve * h;
  if (disc < 0.0) { return h / slope; }
  // The stable form of the root nearest zero; it is the step to the
  // surface, so the distance is its negative.
  return 2.0 * h / (slope + sqrt(disc));
}

// The way out of a region at p: its outward unit normal.
fn regionOutward(r : Region, p : vec3<f32>) -> vec3<f32> {
  let nd = nodes[r.node];
  let g = r.sign * gradAt(nd, p);
  let crit = atCritical(r, r.sign * fAt(nd, p), length(g));
  if (crit.found) { return crit.dir; }
  return normalize(g);
}

// How far a region's boundary is where its gradient vanishes - a sphere's
// centre, a cylinder's axis, a slab's middle plane - or is too small next
// to its curvature to give a direction; not found where the gradient will
// do. There H along any unit
// direction n is h + s^2 n.K.n, so the nearest boundary lies along whichever
// direction K curves the most towards it: from inside (h < 0) the most
// positive curvature, at sqrt(-h / q); from outside the most negative.
// Where nothing curves that way the boundary is never reached. (Taking
// such a point as on the boundary, as the gradient's length alone did, put
// a slab's middle nearer than the face a ball rested on: a NaN normal, a
// contact 2000 km deep, and the ball gone.) The signed K's curvatures are
// k_perp, square to the axis, and k_perp + k_delta, along it; the direction
// either way along it is as good, since H is even about p. On the boundary
// itself (a cone's apex) the distance is 0.
struct Critical {
  found    : bool,
  dir      : vec3<f32>,
  distance : f32,
};

fn atCritical(r : Region, h : f32, slope : f32) -> Critical {
  let nd = nodes[r.node];
  let across = r.sign * nd.curvature_perp;
  let along = r.sign * (nd.curvature_perp + nd.curvature_delta);
  let most = max(abs(across), abs(along));
  if (slope * slope > 1e-8 * abs(h) * most + 1e-30) { return Critical(false, vec3<f32>(0.0), 0.0); }
  var helper = vec3<f32>(1.0, 0.0, 0.0);
  if (abs(nd.axis.x) > 0.9) { helper = vec3<f32>(0.0, 1.0, 0.0); }
  let square = normalize(cross(nd.axis, helper));
  if (h < 0.0) {
    let q = max(across, along);
    var dir = square;
    if (along >= across) { dir = nd.axis; }
    if (q <= 0.0) { return Critical(true, dir, -NEVER); }
    return Critical(true, dir, -sqrt(-h / q));
  }
  if (h > 0.0) {
    let q = min(across, along);
    var dir = square;
    if (along <= across) { dir = nd.axis; }
    if (q >= 0.0) { return Critical(true, dir, NEVER); }
    return Critical(true, dir, sqrt(h / -q));
  }
  return Critical(true, square, 0.0);
}

// Further than anything here: the distance to a boundary never reached.
const NEVER : f32 = 1e6;

// A point this far outside a region still counts as on it (meters).
const CONTACT_SLOP : f32 = 1e-3;
// Rounds of nudging a candidate point into the regions it is outside of.
const PROJECTION_SWEEPS : i32 = 8;

const NO_CONTACT = Contact(vec3<f32>(0.0), 0.0, vec3<f32>(0.0), 0u);

// The deepest a point is inside a path: the distance to its nearest
// boundary (the region it is least deep in). Negative inside.
fn pathDistance(pa : Path, p : vec3<f32>) -> f32 {
  var d = -1e30;
  for (var i = 0u; i < pa.count; i = i + 1u) { d = max(d, regionDistance(regions[pa.first + i], p)); }
  return d;
}

// Where to look for path A meeting path B, from the certificates of their
// region pairs: none, if some pair is proved apart (found false); else
// `start`, the finite point of the pair closest to separating that has one
// - the witness there, or where that pair touches - and `away`, the
// direction of the pair closest to separating whose point is at infinity
// (zero if none). Pairs with unbounded regions can meet only at infinity -
// a rod's endless cylinder and the outside of a crater's ball - and are
// often the closest to separating; taken as the start, every rod in a
// crater wall went unseen, until one was found 0.7 m in and thrown out at
// 100 m/s. A point at infinity is still a direction, though: the way along
// which the two go on overlapping, out to where the rest of each path
// ends. In f32 such a point comes back merely far, so anything further
// than FAR counts as at infinity.
const FAR : f32 = 1e4;

struct Meeting {
  found : bool,
  start : vec3<f32>,
  away  : vec3<f32>,
};

fn meetingPoint(pa : Path, pb : Path) -> Meeting {
  var best = -1e30;
  var start = vec4<f32>(0.0);
  var bestAway = -1e30;
  var away = vec3<f32>(0.0);
  for (var i = 0u; i < pa.count; i = i + 1u) {
    let ra = regions[pa.first + i];
    for (var j = 0u; j < pb.count; j = j + 1u) {
      let rb = regions[pb.first + j];
      let c = certify(regionMatrix(nodes[ra.node], ra.sign), regionMatrix(nodes[rb.node], rb.sign));
      if (c.margin > OVERLAP_TAU) { return Meeting(false, vec3<f32>(0.0), vec3<f32>(0.0)); }
      let size = length(c.vector.xyz);
      if (abs(c.vector.w) * FAR > size) {
        if (c.margin > best) { best = c.margin; start = c.vector; }
      } else if (size > 0.0 && c.margin > bestAway) {
        bestAway = c.margin;
        away = c.vector.xyz / size;
      }
    }
  }
  if (best == -1e30) { return Meeting(false, vec3<f32>(0.0), vec3<f32>(0.0)); }
  return Meeting(true, start.xyz / start.w, away);
}

// The directions to search along from the start, as many as MAX_WAYS: the
// meeting's way to infinity, then the axes of whichever regions of either
// path have one of their own (a cylinder's, a slab's, a cone's - the long
// way of a rod, a capsule or a rocket, at whose ends it meets what it
// lies in), each once.
const MAX_WAYS : u32 = 3u;

struct Ways {
  count : u32,
  dirs  : array<vec3<f32>, 3>,
};

fn addWay(w : ptr<function, Ways>, d : vec3<f32>) {
  if ((*w).count >= MAX_WAYS || dot(d, d) == 0.0) { return; }
  for (var i = 0u; i < (*w).count; i = i + 1u) {
    if (abs(dot((*w).dirs[i], d)) > 0.99) { return; }
  }
  (*w).dirs[(*w).count] = d;
  (*w).count = (*w).count + 1u;
}

fn axesOf(w : ptr<function, Ways>, pv : Path) {
  for (var i = 0u; i < pv.count; i = i + 1u) {
    let nd = nodes[regions[pv.first + i].node];
    if (nd.curvature_delta != 0.0) { addWay(w, nd.axis); }
  }
}

fn waysOf(m : Meeting, pa : Path, pb : Path) -> Ways {
  var w : Ways;
  w.count = 0u;
  addWay(&w, m.away);
  axesOf(&w, pa);
  axesOf(&w, pb);
  return w;
}

// Seed k of the search: 0 is the meeting's start; the rest walk along one
// of the ways, either way, to where path A ends or path B does, less a
// hair so as to be still inside - from the start settled into that path
// alone, since the start can be outside it (a slab's witness above the
// rod it bounds). w = 0 for none.
fn seedPoint(m : Meeting, ways : Ways, pa : Path, pb : Path, k : u32) -> vec4<f32> {
  if (k == 0u) { return vec4<f32>(m.start, 1.0); }
  let way = (k - 1u) / 4u;
  if (way >= ways.count) { return vec4<f32>(0.0); }
  var dir = ways.dirs[way];
  if (((k - 1u) & 1u) == 1u) { dir = -dir; }
  var path = pa;
  if (((k - 1u) & 2u) == 2u) { path = pb; }
  let inside = settleFor(path, Path(0u, 0u), m.start, PROJECTION_SWEEPS);
  let t = pathExit(path, inside, dir);
  if (t <= 0.0 || t >= NEVER) { return vec4<f32>(0.0); }
  return vec4<f32>(inside + (t - 0.5 * CONTACT_SLOP) * dir, 1.0);
}

// Nudge p onto every region of both paths it is outside of, along each
// region's gradient, a few rounds. For convex regions this finds a point in
// all of them when there is one; started outside the overlap, it ends on
// the overlap's edge nearest the start.
fn settleInto(pa : Path, pb : Path, start : vec3<f32>) -> vec3<f32> {
  return settleFor(pa, pb, start, PROJECTION_SWEEPS);
}

fn settleFor(pa : Path, pb : Path, start : vec3<f32>, sweeps : i32) -> vec3<f32> {
  var p = start;
  for (var sweep = 0; sweep < sweeps; sweep = sweep + 1) {
    var outside = false;
    for (var i = 0u; i < pa.count + pb.count; i = i + 1u) {
      var r : Region;
      if (i < pa.count) { r = regions[pa.first + i]; } else { r = regions[pb.first + i - pa.count]; }
      let d = regionDistance(r, p);
      if (d > 0.0) {
        p = p - (d + 0.5 * CONTACT_SLOP) * regionOutward(r, p);   // just inside
        outside = true;
      }
    }
    if (!outside) { break; }
  }
  return p;
}

// How far from p along dir until leaving region r (p inside it): the
// smallest t >= 0 where sign H(p + t dir) = 0, from the quadratic
// sign (H(p) + t grad.dir + t^2 dir.K.dir). Never leaving is a long way.
fn exitAlong(r : Region, p : vec3<f32>, dir : vec3<f32>) -> f32 {
  let nd = nodes[r.node];
  let c = r.sign * fAt(nd, p);
  if (c >= 0.0) { return 0.0; }
  let b = r.sign * dot(gradAt(nd, p), dir);
  let along = dot(nd.axis, dir);
  let a = r.sign * (nd.curvature_perp * dot(dir, dir) + nd.curvature_delta * along * along);
  if (abs(a) < 1e-20) {
    if (b > 0.0) { return -c / b; }
    return NEVER;
  }
  let disc = b * b - 4.0 * a * c;
  if (disc < 0.0) { return NEVER; }
  let q = -0.5 * (b + select(-1.0, 1.0, b >= 0.0) * sqrt(disc));
  let t1 = q / a;
  let t2 = c / q;
  var t = NEVER;
  if (t1 >= 0.0) { t = min(t, t1); }
  if (t2 >= 0.0) { t = min(t, t2); }
  return t;
}

// ... and until leaving a path, which is left at the first of its regions.
fn pathExit(pa : Path, p : vec3<f32>, dir : vec3<f32>) -> f32 {
  var t = 1e6;
  for (var i = 0u; i < pa.count; i = i + 1u) { t = min(t, exitAlong(regions[pa.first + i], p, dir)); }
  return t;
}

// A contact at p, if p really is in both paths. The way out of B is out
// through B's nearest boundary, n; depth is how much of the line through p
// along n both solids share - out of B along n, plus out of A along -n -
// which is what a push along n must remove there. (Not how deep p is in
// each by its nearest boundary: in a rod's end tipped nearly on edge, the
// end face is the nearest boundary, a millimetre sideways, while the rod
// goes on 12 cm below p - a depth that let it sink out of sight until one
// deep point threw it into the air.) A point let in by CONTACT_SLOP but
// outside a path is short of the overlap by that much, so that comes off:
// settled between a base and the ground 0.2 mm apart, a point half a
// millimetre into the ground counted that half millimetre as depth, and
// the pushes it made threw the base up off the ground every few substeps.
fn contactAt(pa : Path, pb : Path, p : vec3<f32>) -> Contact {
  // A point that isn't finite (a support point from a degenerate case) is
  // no contact. It has to be refused here: taking the max of distances
  // (pathDistance) drops a NaN rather than passing it on, which made one
  // look deep inside both - and pushed a body 8 km in a substep.
  if (!all(abs(p) < vec3<f32>(1e30))) { return NO_CONTACT; }
  let dA = pathDistance(pa, p);
  let dB = pathDistance(pb, p);
  if (!(dA <= CONTACT_SLOP && dB <= CONTACT_SLOP)) { return NO_CONTACT; }
  var outOfB = vec3<f32>(0.0);
  var nearest = -1e30;
  for (var j = 0u; j < pb.count; j = j + 1u) {
    let rb = regions[pb.first + j];
    let d = regionDistance(rb, p);
    if (d > nearest) { nearest = d; outOfB = regionOutward(rb, p); }
  }
  let overlap = pathExit(pb, p, outOfB) + pathExit(pa, p, -outOfB) - max(dA, 0.0) - max(dB, 0.0);
  return Contact(p, max(overlap, 0.0), outOfB, 1u);
}

// The point of region r's surface whose outward normal is `out`: where a
// solid bounded by r reaches furthest in that direction. Along directions
// the surface doesn't curve in (all of them for a plane, one for a
// cylinder's length) no point is special, and p's own position there is
// kept. With K' = sign K and L' = sign 2c, the gradient is 2 K' x + L', so
// along each direction K' curves in, x is linear in the step s where the
// gradient is s out; h(x(s)) = 0 is then a quadratic in s, whose positive
// root is the point. Returns p when there is none.
fn supportPoint(r : Region, out : vec3<f32>, at : vec3<f32>) -> vec3<f32> {
  let nd = nodes[r.node];
  // Worked about the node's anchor (see Node), and returned in the world.
  let p = at - nd.anchor;
  let a = nd.axis;
  let alongA = r.sign * (nd.curvature_perp + nd.curvature_delta);   // K' along the axis
  let across = r.sign * nd.curvature_perp;                            // and square to it
  let lin = r.sign * nd.linear;
  let isotropic = nd.curvature_delta == 0.0;
  // x(s) = x0 + s x1, component by component in (along a, across a).
  let pa = dot(p, a) * a;
  let pc = p - pa;
  var x0 = vec3<f32>(0.0);
  var x1 = vec3<f32>(0.0);
  if (isotropic) {
    if (abs(across) < 1e-20) { return at; }                          // a plane: flat everywhere
    x0 = -lin / (2.0 * across);
    x1 = out / (2.0 * across);
  } else {
    if (abs(alongA) > 1e-20) {
      x0 = x0 + (-dot(lin, a) / (2.0 * alongA)) * a;
      x1 = x1 + (dot(out, a) / (2.0 * alongA)) * a;
    } else { x0 = x0 + pa; }
    if (abs(across) > 1e-20) {
      x0 = x0 + (-(lin - dot(lin, a) * a)) / (2.0 * across);
      x1 = x1 + (out - dot(out, a) * a) / (2.0 * across);
    } else { x0 = x0 + pc; }
  }
  // h(x0 + s x1) = A s^2 + B s + C, from three samples.
  let h0 = r.sign * fAbout(nd, x0);
  let hp = r.sign * fAbout(nd, x0 + x1);
  let hm = r.sign * fAbout(nd, x0 - x1);
  let qa = 0.5 * (hp + hm) - h0;
  let qb = 0.5 * (hp - hm);
  let disc = qb * qb - 4.0 * qa * h0;
  if (abs(qa) < 1e-20 || disc < 0.0) { return at; }
  let root = (-qb + sqrt(disc)) / (2.0 * qa);
  let other = (-qb - sqrt(disc)) / (2.0 * qa);
  let s = max(root, other);
  if (s <= 0.0) { return at; }
  return nd.anchor + x0 + s * x1;
}

// Whether a region curves along direction `out`, so that its support
// point facing that way is well defined: a sphere always, a cylinder when
// `out` crosses its axis (a lying rod's bottom line), a slab along its own
// axis. Not a plane, and not a cylinder pushed along its length, where
// the point would be anywhere - or, nearly so, flip from side to side with
// a tiny tilt.
fn curvesAlong(r : Region, out : vec3<f32>) -> bool {
  let nd = nodes[r.node];
  let along = dot(nd.axis, out);
  let k = r.sign * (nd.curvature_perp * dot(out, out) + nd.curvature_delta * along * along);
  let most = max(abs(nd.curvature_perp), abs(nd.curvature_perp + nd.curvature_delta));
  return k > 0.05 * most;
}

// Whether a region bulges at the scale of a body `reach` across: its
// tightest radius of curvature, 1 / (2 k), within ten of them. A planetoid
// 500 m round bulges, but is flat under a rocket 1 m across.
fn bulgesAt(r : Region, reach : f32) -> bool {
  let nd = nodes[r.node];
  let k = min(r.sign * nd.curvature_perp, r.sign * (nd.curvature_perp + nd.curvature_delta));
  return k > 0.0 && 1.0 / (2.0 * k) < 10.0 * reach;
}

// The region of a path whose boundary p is nearest (least deep in).
fn tightest(pa : Path, p : vec3<f32>) -> Region {
  var best = regions[pa.first];
  var d = -1e30;
  for (var i = 0u; i < pa.count; i = i + 1u) {
    let r = regions[pa.first + i];
    let di = regionDistance(r, p);
    if (di > d) { d = di; best = r; }
  }
  return best;
}

/**
 * Where path A (of one solid) meets path B (of another), if it does.
 *
 * 1. Every region of A against every region of B: if any pair is proved
 *    apart, so are the paths.
 * 2. Otherwise start from the certificate's point for the pair closest to
 *    separating that has a finite one (meetingPoint) - and also from
 *    where each path ends along a few directions, either way (waysOf,
 *    seedPoint): the way the pair closest to separating at infinity goes
 *    there, and the axes of regions with one. A rod lying in a crater
 *    meets its walls at its ends, which no finite witness is near, and
 *    settling from the middle of the rod finds nothing.
 * 3. Each may lie outside some other region: the witness of an endless
 *    cylinder meeting a planet can be past the end its slab cuts off. So
 *    settle it into all of them (settleInto), keeping the deepest contact
 *    of all the starts.
 * 4. Only a point inside every region of both paths makes a contact, so
 *    the certificate being conservative never makes one up (contactAt).
 * 5. That point can be anywhere in the overlap - often at its edge, where
 *    the two surfaces cross and the overlap along the normal is nil, even
 *    with the body sunk 14 cm in elsewhere. And a push off-centre turns a
 *    body: 0.1 mm off under a resting ball set it rolling away. So where a
 *    side's nearest boundary curves along the push (a ball, a lying rod's
 *    underside), move the point to that side's support point facing the
 *    other - straight under the ball's centre, along the rod's bottom
 *    line - A's first, then B's, keeping each only if it is still in both.
 *    Where it doesn't curve (a flat face) there is no such point, and the
 *    one it has stays, which is also what holds a tilted base's low rim.
 * 6. A side made only of planes - a polyhedron - has corners, and a
 *    corner in the other side is where it is deepest, and needs no
 *    search: settling (3) crawls into the narrow tip of a corner sunk in
 *    the ground so slowly that 8 rounds missed an octahedron's corner
 *    33 cm deep. So each side's corners are tried too (deepestCorner),
 *    and the deepest contact of all is kept. The search is still needed:
 *    where edges cross, no corner is in anything.
 */
fn pathContact(pa : Path, pb : Path) -> Contact {
  let m = meetingPoint(pa, pb);
  if (!m.found) { return NO_CONTACT; }
  let ways = waysOf(m, pa, pb);
  var c = NO_CONTACT;
  for (var k = 0u; k < 1u + 4u * ways.count; k = k + 1u) {
    let seed = seedPoint(m, ways, pa, pb, k);
    if (seed.w == 0.0) { continue; }
    let found = contactAt(pa, pb, settleInto(pa, pb, seed.xyz));
    if (found.found != 0u && (c.found == 0u || found.depth > c.depth)) { c = found; }
  }
  if (c.found != 0u) {
    // Each side's support point faces the other's surface: its outward
    // normal there is the reverse of the other side's. (Its own normal at
    // an off-centre point would just point back through that point.)
    let ra = tightest(pa, c.point);
    let rb = tightest(pb, c.point);
    let outOfA = -regionOutward(rb, c.point);
    if (curvesAlong(ra, outOfA)) {
      let x = supportPoint(ra, outOfA, c.point);
      let better = contactAt(pa, pb, x);
      if (better.found != 0u) { c = better; }
    }
    let outOfB = -regionOutward(ra, c.point);
    if (curvesAlong(rb, outOfB)) {
      let x = supportPoint(rb, outOfB, c.point);
      let better = contactAt(pa, pb, x);
      if (better.found != 0u) { c = better; }
    }
  }
  for (var side = 0u; side < 2u; side = side + 1u) {
    var corners = pa;
    if (side == 1u) { corners = pb; }
    let k = deepestCorner(corners, pa, pb);
    if (k.found != 0u && (c.found == 0u || k.depth > c.depth)) { c = k; }
  }
  return c;
}

// The most planes a path can have for its corners to be tried: every
// three of them meet at a point, so twelve is 220 points.
const MAX_CORNER_PLANES : u32 = 12u;

// A plane's constant about the world origin, its node's being about its
// anchor (see Node): n.(x - a) + d is n.x + (d - n.a). A plane's anchor is
// the origin, as packNodes() chooses, but this doesn't rely on it.
fn planeConst(nd : Node) -> f32 {
  return nd.const_term - dot(nd.linear, nd.anchor);
}

// If path pv is all planes, the deepest of its corners - points where
// three of them meet, and in all the rest - that makes a contact between
// pa and pb (one of which pv is); NO_CONTACT otherwise.
fn deepestCorner(pv : Path, pa : Path, pb : Path) -> Contact {
  if (pv.count < 3u || pv.count > MAX_CORNER_PLANES) { return NO_CONTACT; }
  for (var i = 0u; i < pv.count; i = i + 1u) {
    let nd = nodes[regions[pv.first + i].node];
    if (nd.curvature_perp != 0.0 || nd.curvature_delta != 0.0) { return NO_CONTACT; }
  }
  // Plane r as n.x < d, inside: sign (linear.x + const) < 0.
  var best = NO_CONTACT;
  for (var i = 0u; i < pv.count; i = i + 1u) {
    let ri = regions[pv.first + i];
    let ni = ri.sign * nodes[ri.node].linear;
    let di = -ri.sign * planeConst(nodes[ri.node]);
    for (var j = i + 1u; j < pv.count; j = j + 1u) {
      let rj = regions[pv.first + j];
      let nj = rj.sign * nodes[rj.node].linear;
      let dj = -rj.sign * planeConst(nodes[rj.node]);
      for (var k = j + 1u; k < pv.count; k = k + 1u) {
        let rk = regions[pv.first + k];
        let nk = rk.sign * nodes[rk.node].linear;
        let dk = -rk.sign * planeConst(nodes[rk.node]);
        let jk = cross(nj, nk);
        let det = dot(ni, jk);
        if (abs(det) < 1e-6 * length(ni) * length(nj) * length(nk)) { continue; }   // parallel, near enough
        let x = (di * jk + dj * cross(nk, ni) + dk * cross(ni, nj)) / det;
        // A corner of the solid only if it is in (or on) every other plane.
        if (pathDistance(pv, x) > 1e-4) { continue; }
        let c = contactAt(pa, pb, x);
        if (c.found != 0u && (best.found == 0u || c.depth > best.depth)) { best = c; }
      }
    }
  }
  return best;
}

// -- batch contacts, for tests and tools ----------------------------------------------

struct ContactQuery {
  path_a : u32,       // indices into paths
  path_b : u32,
};

var<storage, read> contactQueries : array<ContactQuery>;
var<storage, read_write> contactResults : array<Contact>;

@compute @workgroup_size(64)
fn contactFrom(@builtin(global_invocation_id) gid : vec3<u32>) {
  let i = gid.x;
  if (i >= arrayLength(&contactQueries)) { return; }
  let q = contactQueries[i];
  contactResults[i] = pathContact(paths[q.path_a], paths[q.path_b]);
}
